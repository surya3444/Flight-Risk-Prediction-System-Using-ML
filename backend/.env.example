# ── Core ────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://user:pass@cluster/dbname
PORT=8000
JWT_SECRET=change-me

# ── Risk model service (Flask) ──────────────────────────────────────────────
# May point at the service root or directly at /predict — both are handled.
FLIGHT_ML_API_URL=http://localhost:5000
FLIGHT_ML_API_KEY=supersecretkey123
FLIGHT_ML_TIMEOUT_MS=15000

# ── Weather (REQUIRED for continuous monitoring) ─────────────────────────────
# The monitoring scheduler refreshes conditions server-side, so the key must
# exist here as well as in the frontend. Without it, monitored flights keep
# scoring against their last known weather and every snapshot is marked stale.
OPENWEATHER_API_KEY=

# ── Alert delivery: Gmail SMTP ───────────────────────────────────────────────
# GMAIL_APP_PASSWORD is a 16-character App Password, NOT your Google account
# password — Google stopped accepting account passwords for SMTP in May 2022.
# Generate one at https://myaccount.google.com/apppasswords (needs 2-Step
# Verification enabled first). Paste it with or without spaces; both work.
#
# Free Gmail allows roughly 500 recipients per day. Fine for an OCC.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=

# Port 587 uses STARTTLS (default). Set 465 for implicit TLS — the `secure`
# flag is derived from the port, so just changing this number is enough.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Display name on outgoing alerts. The address itself is always GMAIL_USER —
# Gmail rewrites the envelope to the authenticated mailbox regardless.
MAIL_FROM_NAME=AeroSafe OCC
MAIL_REPLY_TO=

# SMS paging for emergency-tier escalations. Optional — with these unset the
# SMS channel reports "skipped" and every other channel still works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Monitoring scheduler ─────────────────────────────────────────────────────
# How often the loop wakes up. Per-flight cadence is set on the flight itself;
# this is just the granularity at which due flights are picked up.
MONITOR_TICK_MS=30000
MONITOR_BATCH_SIZE=25
